# Copy to .env and fill in. Never commit .env.

# App database: role netdoi_stock, database netdoi_v2 (schema "stock").
# Use the same value as the working .env on the dev PC.
DATABASE_URL=postgresql://netdoi_stock:<password>@192.168.233.200:5432/netdoi_v2

# Random secret for login sessions, e.g. `openssl rand -base64 48`.
# Changing it logs everyone out.
JWT_SECRET=<random>
